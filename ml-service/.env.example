# PostgreSQL + pgvector (obrigatório: o dashboard inteiro vem do banco)
DATABASE_URL=postgresql://pixel:pixel@localhost:5433/pixeloracle

# Embeddings
# Jogos (busca de similares) — título+descrição
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Resumos de aspecto em português (cluster de temas) — também 384 dims
ASPECT_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
SIMILAR_GAMES_TOP_K=5

# Coleta de reviews (opcional: com chave do app o rate limit é maior)
STEAM_API_KEY=

# ABSA e nomeação de temas (offline)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 0 = sem raciocínio (extração ~10x mais rápida); vazio = padrão do modelo
GEMINI_THINKING_BUDGET=0

# Onde gravar logs de experimentos (padrão: <repo>/experiments)
# EXPERIMENTS_DIR=
