# Fonte de dados legado (treino RF ainda pode usar JSON)
DATA_SOURCE=json
# DATA_JSON_PATH=data/database_steam_br.json
INCLUDE_REVIEW_FEATURES=false

# PostgreSQL + pgvector (obrigatório para /retrieve-similar e RAG completo)
DATABASE_URL=postgresql://pixel:pixel@localhost:5433/pixeloracle

# Embeddings / retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2
SIMILAR_GAMES_TOP_K=5

# APIs externas (coleta offline + ABSA)
STEAM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# MongoDB legado (somente se DATA_SOURCE=mongo)
# MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/
# MONGO_DB=pixeloracle
# MONGO_COLLECTION=steam_games
