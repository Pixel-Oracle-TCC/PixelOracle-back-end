# Copie para .env na raiz (usado pelo docker compose e opcionalmente pelos serviços)
# cp .env.example .env

# Gemini (BFF) — opcional; sem chave, /api/report usa dicas fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ML (opcional; o compose já define padrões pré-lançamento)
# DATA_SOURCE=json
# INCLUDE_REVIEW_FEATURES=false
