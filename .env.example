# Opcional: .env na raiz é lido pelo docker compose (ml-service e api).
# Prefira configurar api/.env e ml-service/.env; valores vazios aqui podem sobrescrever os de lá.
# cp .env.example .env

# Gemini — sem chave, /api/report usa a narrativa automática (fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Postgres — KPIs da API (/kpis/dashboard, /kpis/releases) e ml-service
# No Docker o compose usa db:5432; localmente a porta publicada é 5433.
DATABASE_URL=postgresql://pixel:pixel@localhost:5433/pixeloracle
